# ============================================================================
# MoSPI × iGOT Karmayogi Engine — Environment Configuration
# ============================================================================

# Database (Supabase PostgreSQL / pgvector)
# Leave unset or empty to use built-in grounded in-memory vector database
DATABASE_URL="postgresql://postgres.example:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.example:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# Unified LLM Service Configuration (Backend Only)
# Configure ANY ONE of the following providers for live LLM generation:
# ============================================================================

# Option 1: OpenAI (Recommended: gpt-4o-mini or gpt-4o)
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Option 2: Google Gemini (gemini-1.5-flash or gemini-2.0-flash)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"

# Option 3: Anthropic Claude (claude-3-5-sonnet-20241022 or claude-3-haiku-20240307)
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Option 4: Groq (ultra-fast inference: llama-3.3-70b-versatile)
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"

# Option 5: Custom OpenAI-Compatible / Local Endpoint (Ollama, vLLM, LM Studio)
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_API_KEY="ollama"
# LLM_MODEL="llama3"

# ============================================================================
# iGOT Karmayogi / Sunbird Sandbox Credentials
# Leave both unset to run against built-in sovereign mock integration
# ============================================================================
IGOT_API_BASE_URL=""
IGOT_SERVICE_TOKEN=""
